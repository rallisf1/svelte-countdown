{
    "name": "svelte-countdown",
    "version": "2.0.0",
    "description": "CSS-agnostic countdown component for Svelte 5",
    "repository": {
        "type": "git",
        "url": "https://github.com/rallisf1/svelte-countdown"
    },
    "homepage": "",
    "bugs": {
        "url": "https://github.com/rallisf1/svelte-countdown/issues"
    },
    "main": "src/index.js",
    "module": "src/index.js",
    "svelte": "src/index.js",
    "exports": {
        ".": {
            "svelte": "./src/index.js",
            "default": "./src/index.js"
        }
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "check": "svelte-check --tsconfig ./jsconfig.json",
        "demo": "vite --config demo/vite.config.js",
        "demo:build": "vite build --config demo/vite.config.js",
        "test": "npm run check"
    },
    "keywords": [
        "svelte5",
        "svelte",
        "countdown"
    ],
    "author": "rallisf1",
    "license": "MIT",
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "vite": "^8.1.5"
    },
    "dependencies": {
        "luxon": "^3.0.1"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    }
}
